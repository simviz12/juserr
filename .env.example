# Postgres connection string from Neon dashboard
DATABASE_URL="postgresql://[user]:[password]@[endpoint_hostname]/[dbname]?sslmode=require"

# Consola de plataforma: datos de pago que ve cada restaurante en /facturacion
# (separa los pasos con |)
PAGO_INSTRUCCIONES="Nequi 300 000 0000 a nombre de MesaCapital | Transferencia Bancolombia ahorros 000-000000-00 | Envía el comprobante por WhatsApp"
# WhatsApp de soporte/cobros (solo números, con indicativo)
SOPORTE_WHATSAPP="573000000000"
